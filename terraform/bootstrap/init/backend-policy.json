{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "ListBucketContents",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucket"
			],
			"Resource": "arn:aws:s3:::production-ready-voting-app"
		},
		{
			"Sid": "ReadWriteAndLockState",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:DeleteObject"
			],
			"Resource": [
				"arn:aws:s3:::production-ready-voting-app/*.tfstate",
				"arn:aws:s3:::production-ready-voting-app/*.tflock"
			]
		},
		{
			"Sid": "AllowKMSRuntime",
			"Effect": "Allow",
			"Action": [
				"kms:CreateKey",
				"kms:TagResource",
				"kms:DescribeKey",
				"kms:ScheduleKeyDeletion",
				"kms:EnableKeyRotation",
				"kms:GetKeyRotationStatus",
				"kms:ListResourceTags",
				"kms:GetKeyPolicy",
				"kms:CreateAlias",
				"kms:ListAliases"
			],
			"Resource": "*"
		},
		{
			"Sid": "AllowS3Creation",
			"Effect": "Allow",
			"Action": [
				"s3:*"
			],
			"Resource": [
        "arn:aws:s3:::flamingo-voting-app-tfstate",
        "arn:aws:s3:::flamingo-voting-app-tfstate/*"
      ]
		}
	]
}