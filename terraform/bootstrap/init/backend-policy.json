{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "ListBucketContents",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucket"
			],
			"Resource": "arn:aws:s3:::flamingo-voting-app-tfstate"
		},
		{
			"Sid": "ReadWriteAndLockState",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:DeleteObject"
			],
			"Resource": [
				"arn:aws:s3:::flamingo-voting-app-tfstate/*.tfstate",
				"arn:aws:s3:::flamingo-voting-app-tfstate/*.tflock"
			]
		},
		{
			"Sid": "AllowKMSRuntime",
			"Effect": "Allow",
			"Action": [
				"kms:CreateKey",
				"kms:TagResource",
				"kms:DescribeKey",
				"kms:ScheduleKeyDeletion",
				"kms:EnableKeyRotation",
				"kms:GetKeyRotationStatus",
				"kms:ListResourceTags",
				"kms:GetKeyPolicy",
				"kms:CreateAlias",
				"kms:ListAliases"
			],
			"Resource": "*"
		},
		{
			"Sid": "UseTerraformStateKmsKey",
			"Effect": "Allow",
			"Action": [
				"kms:Encrypt",
				"kms:Decrypt",
				"kms:GenerateDataKey"
			],
			"Resource": "arn:aws:kms:us-east-1:365020425296:key/67f757f6-dccb-45ac-b66d-1b19d32a2bcf"
		},
		{
			"Sid": "AllowS3Creation",
			"Effect": "Allow",
			"Action": [
				"s3:*"
			],
			"Resource": [
        "arn:aws:s3:::flamingo-voting-app-tfstate",
        "arn:aws:s3:::flamingo-voting-app-tfstate/*"
      ]
		}
	]
}