{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::365020425296:role/voting-app-*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::365020425296:role/voting-app-eks-cluster-role",
        "arn:aws:iam::365020425296:role/voting-app-eks-node-role",
        "arn:aws:iam::365020425296:role/voting-app-karpenter-node-role",
        "arn:aws:iam::365020425296:role/voting-app-aws-load-balancer-controller-role",
        "arn:aws:iam::365020425296:role/voting-app-karpenter-pod-identity-role"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::365020425296:policy/voting-app-aws-load-balancer-controller-policy",
        "arn:aws:iam::365020425296:policy/voting-app-karpenter-controller-policy"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::365020425296:role/voting-app-jump-server-role",
        "arn:aws:iam::365020425296:role/voting-app-controller-installer-role"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint",
        "iam:TagOpenIDConnectProvider",
        "iam:UntagOpenIDConnectProvider"
      ],
      "Resource": "arn:aws:iam::365020425296:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::365020425296:role/voting-app-eks-cluster-role",
        "arn:aws:iam::365020425296:role/voting-app-eks-node-role",
        "arn:aws:iam::365020425296:role/voting-app-karpenter-node-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "eks.amazonaws.com"
        }
      }
    }
    ,
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::365020425296:role/voting-app-karpenter-node-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}