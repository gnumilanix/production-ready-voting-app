{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:Describe*",
        "eks:Describe*",
        "eks:Get*",
        "eks:List*",
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:us-east-1::parameter/aws/service/ami-amazon-linux-latest/*",
        "arn:aws:ssm:us-east-1::parameter/aws/service/eks/optimized-ami/*/amazon-linux-2023/x86_64/standard/recommended/image_id"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "aps:CreateWorkspace",
        "aps:TagResource"
      ],
      "Resource": "arn:aws:aps:us-east-1:365020425296:/workspaces"
    },
    {
      "Effect": "Allow",
      "Action": [
        "aps:DescribeWorkspace",
        "aps:DescribeLoggingConfiguration",
        "aps:UpdateLoggingConfiguration",
        "aps:CreateLoggingConfiguration",
        "aps:DeleteLoggingConfiguration",
        "aps:UpdateWorkspaceAlias",
        "aps:DeleteWorkspace",
        "aps:ListTagsForResource",
        "aps:TagResource",
        "aps:UntagResource"
      ],
      "Resource": "arn:aws:aps:us-east-1:365020425296:workspace/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "sso:ListInstances",
        "sso:DescribeInstance",
        "sso:DescribeRegisteredRegions",
        "identitystore:DescribeGroup",
        "identitystore:CreateGroup",
        "identitystore:UpdateGroup",
        "identitystore:DeleteGroup"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "sso:CreateManagedApplicationInstance",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "grafana:CreateWorkspace",
        "grafana:DescribeWorkspace",
        "grafana:UpdateWorkspace",
        "grafana:DeleteWorkspace",
        "grafana:ListTagsForResource",
        "grafana:TagResource",
        "grafana:UntagResource",
        "grafana:AssociateRole",
        "grafana:DisassociateRole",
        "grafana:ListPermissions"
      ],
      "Resource": "*"
    }
  ]
}
