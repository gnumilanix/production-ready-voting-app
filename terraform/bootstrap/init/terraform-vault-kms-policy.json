{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["kms:CreateKey"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:EnableKeyRotation",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags",
        "kms:PutKeyPolicy",
        "kms:TagResource",
        "kms:UntagResource"
      ],
      "Resource": "arn:aws:kms:us-east-1:365020425296:key/*"
    },
    {
      "Effect": "Allow",
      "Action": ["kms:CreateAlias", "kms:UpdateAlias"],
      "Resource": [
        "arn:aws:kms:us-east-1:365020425296:key/*",
        "arn:aws:kms:us-east-1:365020425296:alias/voting-app-vault-unseal"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["kms:DeleteAlias"],
      "Resource": "arn:aws:kms:us-east-1:365020425296:alias/voting-app-vault-unseal"
    },
    {
      "Effect": "Allow",
      "Action": ["kms:ListAliases"],
      "Resource": "*"
    }
  ]
}