{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeployPlan",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeVpcs",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeSubnets",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeRouteTables",
        "ec2:DescribeAddresses",
        "ec2:DescribeNatGateways"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateVpcAndInternetGateway",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:CreateInternetGateway",
        "ec2:AttachInternetGateway"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:365020425296:vpc/*",
        "arn:aws:ec2:us-east-1:365020425296:internet-gateway/*"
      ]
    },
    {
      "Sid": "CreateSubnetsAndRouteTables",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:CreateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:365020425296:subnet/*",
        "arn:aws:ec2:us-east-1:365020425296:route-table/*",
        "arn:aws:ec2:us-east-1:365020425296:vpc/*"
      ]
    },
    {
      "Sid": "CreateRoutesAndAssociations",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRoute",
        "ec2:AssociateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:365020425296:route-table/*",
        "arn:aws:ec2:us-east-1:365020425296:subnet/*",
        "arn:aws:ec2:us-east-1:365020425296:vpc/*",
        "arn:aws:ec2:us-east-1:365020425296:internet-gateway/*"
      ]
    },
    {
      "Sid": "ManageNatGatewaysAndElasticIps",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNatGateway",
        "ec2:DeleteNatGateway"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:365020425296:natgateway/*",
        "arn:aws:ec2:us-east-1:365020425296:subnet/*",
        "arn:aws:ec2:us-east-1:365020425296:elastic-ip/*"
      ]
    },
    {
      "Sid": "AllocateAndReleaseNatElasticIps",
      "Effect": "Allow",
      "Action": [
        "ec2:AllocateAddress",
        "ec2:ReleaseAddress"
      ],
      "Resource": "arn:aws:ec2:us-east-1:365020425296:elastic-ip/*"
    },
    {
      "Sid": "TagNatResources",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:365020425296:natgateway/*",
        "arn:aws:ec2:us-east-1:365020425296:elastic-ip/*"
      ]
    },
    {
      "Sid": "DeletePrivateDefaultRoutes",
      "Effect": "Allow",
      "Action": "ec2:DeleteRoute",
      "Resource": "arn:aws:ec2:us-east-1:365020425296:route-table/*"
    },
    {
      "Sid": "TagVpcNetworkResources",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:365020425296:vpc/*",
        "arn:aws:ec2:us-east-1:365020425296:internet-gateway/*",
        "arn:aws:ec2:us-east-1:365020425296:subnet/*",
        "arn:aws:ec2:us-east-1:365020425296:route-table/*"
      ]
    },
    {
      "Sid": "ReadDeployStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::flamingo-voting-app-tfstate"
    },
    {
      "Sid": "ReadDeployState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::flamingo-voting-app-tfstate/deploy/terraform.tfstate"
    },
    {
      "Sid": "ManageDeployStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:ListMultipartUploadParts",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::flamingo-voting-app-tfstate/deploy/terraform.tfstate.tflock"
    }
  ]
}