# Only micro, small, and medium EC2 instance sizes are allowed.
# Covers standalone instances, launch templates, and EKS managed node groups.

import "tfplan/v2" as tfplan
import "strings"
import "common"

allowed_sizes = ["micro", "small", "medium"]

instance_size = func(instance_type) {
	parts = strings.split(instance_type, ".")
	if length(parts) < 2 {
		return ""
	}
	return parts[1]
}

violating_instances = filter common.applied_changes as rc {
	rc.type is "aws_instance" and
		rc.change.after.instance_type is not null and
		instance_size(rc.change.after.instance_type) not in allowed_sizes
}

violating_templates = filter common.applied_changes as rc {
	rc.type is "aws_launch_template" and
		rc.change.after.instance_type is not null and
		instance_size(rc.change.after.instance_type) not in allowed_sizes
}

violating_nodegroups = filter common.applied_changes as rc {
	rc.type is "aws_eks_node_group" and
		rc.change.after.instance_types is not null and
		any rc.change.after.instance_types as it {
			instance_size(it) not in allowed_sizes
		}
}

violations = {}

for violating_instances as rc {
	violations[rc.address] = rc.change.after.instance_type
}
for violating_templates as rc {
	violations[rc.address] = rc.change.after.instance_type
}
for violating_nodegroups as rc {
	violations[rc.address] = rc.change.after.instance_types
}

print_violations = func() {
	for violations as address, value {
		print("instance-size violation:", address, value)
	}
	return true
}

main = rule {
	print_violations() and length(violations) is 0
}
