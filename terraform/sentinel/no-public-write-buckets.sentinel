# Policy 2: no S3 bucket may allow public write.
# Enforced via public access blocks, ACLs, and bucket policies.

import "tfplan/v2" as tfplan
import "strings"
import "json"

applied = filter tfplan.resource_changes as rc {
	rc.mode is "managed" and
		("create" in rc.change.actions or "update" in rc.change.actions)
}

# Public access blocks must block public ACLs and policies (the write paths).
violating_access_blocks = filter applied as rc {
	rc.type is "aws_s3_bucket_public_access_block" and
		(rc.change.after.block_public_acls is not true or
			rc.change.after.block_public_policy is not true)
}

# Bucket ACLs must never be public-read-write.
violating_acls = filter applied as rc {
	rc.type is "aws_s3_bucket_acl" and
		rc.change.after.acl is "public-read-write"
}

write_actions = ["s3:PutObject", "s3:DeleteObject", "s3:PutBucketPolicy", "s3:PutBucketAcl", "s3:*"]

action_allows_write = func(action) {
	return action in write_actions or
		strings.contains(action, "Put") or
		strings.contains(action, "Delete")
}

principal_is_public = func(principal) {
	if principal is "*" {
		return true
	}
	if principal is not null {
		for principal as _, values {
			if values is "*" {
				return true
			}
		}
	}
	return false
}

# Bucket policies must not grant write actions to public principals.
violating_policies = filter applied as rc {
	rc.type is "aws_s3_bucket_policy" and
		rc.change.after.policy is not null and
		any json.unmarshal(rc.change.after.policy).Statement as st {
			st.Effect is "Allow" and
				principal_is_public(st.Principal) and
				any (st.Action else []) as a {
					action_allows_write(a)
				}
		}
}

report = func() {
	for violating_access_blocks as rc {
		print("public-bucket violation:", rc.address, "does not fully block public ACLs/policies")
	}
	for violating_acls as rc {
		print("public-bucket violation:", rc.address, "grants public write via ACL")
	}
	for violating_policies as rc {
		print("public-bucket violation:", rc.address, "policy grants public write")
	}
	return true
}

report_rule = rule { report() }

main = rule {
	report_rule and
	length(violating_access_blocks) is 0 and
	length(violating_acls) is 0 and
	length(violating_policies) is 0
}
