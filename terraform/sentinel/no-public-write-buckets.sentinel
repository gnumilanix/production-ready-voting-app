# No S3 bucket may allow public write.
# Enforced via public access blocks, ACLs, and bucket policies.

import "tfplan/v2" as tfplan
import "json"
import "strings"
import "common"

write_actions = ["s3:PutObject", "s3:DeleteObject", "s3:PutBucketPolicy", "s3:PutBucketAcl", "s3:*"]

action_allows_write = func(action) {
	return action is "*" or
		action in write_actions or
		common.str_contains(action, "Put") or
		common.str_contains(action, "Delete")
}

principal_value_is_public = func(value) {
	if value is "*" {
		return true
	}
	if strings.has_prefix(json.marshal(value), "\"") {
		return value is "*"
	}
	return any value as item {
		item is "*"
	}
}

principal_is_public = func(principal) {
	if principal_value_is_public(principal) {
		return true
	}
	if strings.has_prefix(json.marshal(principal), "\"") {
		return false
	}
	if principal is not null {
		for principal as _, values {
			if principal_value_is_public(values) {
				return true
			}
		}
	}
	return false
}

action_list = func(actions) {
	if actions is null {
		return []
	}
	if strings.has_prefix(json.marshal(actions), "\"") {
		return [actions]
	}
	return actions
}

policy_statements = func(policy) {
	statements = json.unmarshal(policy).Statement
	for statements as key, _ {
		if key is "Effect" {
			return [statements]
		}
	}
	return statements
}

violating_access_blocks = filter common.applied_changes as rc {
	rc.type is "aws_s3_bucket_public_access_block" and
		(rc.change.after.block_public_acls is not true or
			rc.change.after.block_public_policy is not true)
}

violating_acls = filter common.applied_changes as rc {
	rc.type is "aws_s3_bucket_acl" and
		(rc.change.after.acl is "public-read-write" or
			any (rc.change.after.access_control_policy else []) as policy {
				any (policy.grant else []) as grant {
					grant.permission in ["WRITE", "FULL_CONTROL"] and
						any (grant.grantee else []) as grantee {
							grantee.type is "Group" and
								grantee.uri in [
									"http://acs.amazonaws.com/groups/global/AllUsers",
									"http://acs.amazonaws.com/groups/global/AuthenticatedUsers",
								]
						}
				}
			})
}

violating_policies = filter common.applied_changes as rc {
	rc.type is "aws_s3_bucket_policy" and
		rc.change.after.policy is not null and
		any policy_statements(rc.change.after.policy) as st {
			st.Effect is "Allow" and
				principal_is_public(st.Principal) and
				any action_list(st.Action else []) as a {
					action_allows_write(a)
				}
		}
}

violations = {}

for violating_access_blocks as rc {
	violations[rc.address] = "does not fully block public ACLs/policies"
}
for violating_acls as rc {
	violations[rc.address] = "grants public write via ACL"
}
for violating_policies as rc {
	violations[rc.address] = "bucket policy grants public write"
}

print_violations = func() {
	for violations as address, msg {
		print("public-bucket violation:", address, msg)
	}
	return true
}

main = rule {
	print_violations() and length(violations) is 0
}
