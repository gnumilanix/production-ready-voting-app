# EKS clusters must run Kubernetes 1.35 or newer.

import "tfplan/v2" as tfplan
import "strings"
import "common"

min_minor = 35

clusters = filter common.applied_changes as rc {
	rc.type is "aws_eks_cluster"
}

violations = {}

for clusters as rc {
	version = rc.change.after.version
	if version is null {
		violations[rc.address] = "does not pin a cluster version"
	} else if int(strings.split(version, ".")[1]) < min_minor {
		violations[rc.address] = "runs Kubernetes " + version + " (minimum 1.35)"
	}
}

print_violations = func() {
	for violations as address, msg {
		print("eks-version violation:", address, msg)
	}
	return true
}

main = rule {
	print_violations() and length(violations) is 0
}
