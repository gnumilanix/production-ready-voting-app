# EKS cluster API endpoints must not be publicly accessible.

import "tfplan/v2" as tfplan
import "common"

# The provider default for endpoint_public_access is true, so anything other
# than an explicit false is a violation.
violations = {}

for common.applied_changes as rc {
	if rc.type is "aws_eks_cluster" {
		for rc.change.after.vpc_config as cfg {
			if cfg.endpoint_public_access is not false {
				violations[rc.address] = true
			}
		}
	}
}

print_violations = func() {
	for violations as address, _ {
		print("eks-endpoint violation:", address, "allows public API endpoint access")
	}
	return true
}

main = rule {
	print_violations() and length(violations) is 0
}
