# All resources must be deployed to us-east-1.
# Checks resolved Terraform variables and any constant provider regions.

import "tfplan/v2" as tfplan
import "common"

required_region = "us-east-1"

# Safely read a constant region from a provider config, returning null when the
# provider has no expressions (e.g. cloudinit) or no region entry.
constant_region = func(provider) {
	if "expressions" not in keys(provider) {
		return null
	}
	expressions = provider["expressions"]
	if "region" not in keys(expressions) {
		return null
	}
	region = expressions["region"]
	if "constant_value" not in keys(region) {
		return null
	}
	return region["constant_value"]
}

violations = {}

for tfplan.variables as name, variable {
	if common.str_contains(name, "region") and variable.value is not required_region {
		violations["variable " + name] = "is " + string(variable.value) + " (must be us-east-1)"
	}
}

for tfplan.configuration.provider_config as pname, provider {
	if common.str_contains(pname, "aws") {
		region = constant_region(provider)
		if region is not null and region is not required_region {
			violations["provider " + pname] = "has constant region " + region + " (must be us-east-1)"
		}
	}
}

print_violations = func() {
	for violations as subject, msg {
		print("region violation:", subject, msg)
	}
	return true
}

main = rule {
	print_violations() and length(violations) is 0
}
