# EKS managed node groups may scale to at most 4 nodes.

import "tfplan/v2" as tfplan
import "common"

max_allowed = 4

violations = {}

for common.applied_changes as rc {
	if rc.type is "aws_eks_node_group" {
		for rc.change.after.scaling_config as cfg {
			if cfg.max_size is not null and cfg.max_size > max_allowed {
				violations[rc.address] = cfg.max_size
			}
		}
	}
}

print_violations = func() {
	for violations as address, max_size {
		print("nodegroup-size violation:", address, "allows scaling to", max_size, "nodes (max 4)")
	}
	return true
}

main = rule {
	print_violations() and length(violations) is 0
}
